#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid ""
"Create memberships as Draft and use the Activate action after the required "
"payment."
msgstr ""
"أنشئ الاشتراكات بحالة مسودة، واستخدم إجراء التفعيل بعد استكمال الدفع "
"المطلوب."

#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
