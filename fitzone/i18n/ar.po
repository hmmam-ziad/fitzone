#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid "Select a member and package before creating an invoice."
msgstr "يرجى اختيار عضو وباقة قبل إنشاء الفاتورة."

#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid ""
"The first installment must have a successful payment before activating this "
"membership."
msgstr "يجب إتمام دفع القسط الأول بنجاح قبل تفعيل هذا الاشتراك."

#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid "The package must have a valid duration."
msgstr "يجب أن تكون مدة الباقة صالحة."

#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid ""
"This member already has an active or blocked membership for the same package"
" during this period. The package can be purchased again after the current "
"membership period ends."
msgstr ""
"لدى هذا العضو اشتراك نشط أو محظور بالباقة نفسها خلال هذه الفترة. يمكن شراء "
"الباقة مجددًا بعد انتهاء فترة الاشتراك الحالية."

#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid ""
"This membership has an installment plan. Use the plan to manage its invoice "
"and payments."
msgstr "لدى هذا الاشتراك خطة تقسيط. استخدم الخطة لإدارة الفاتورة والمدفوعات."

#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid ""
"This package requires an installment plan. Create the installment plan "
"instead of a regular invoice."
msgstr "تتطلب هذه الباقة خطة تقسيط. أنشئ خطة التقسيط بدلًا من فاتورة عادية."

#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid "Unable to generate a membership barcode."
msgstr "تعذّر إنشاء باركود للاشتراك."

#. module: fitzone
#. odoo-python
#: code:addons/fitzone/models/memberships.py:0
msgid "Use the Activate action to activate a membership."
msgstr "استخدم إجراء التفعيل لتفعيل الاشتراك."

