<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="group_fitzone_staff" model="res.groups">
        <field name="name">FitZone Staff</field>
    </record>

    <record id="group_fitzone_manager" model="res.groups">
        <field name="name">FitZone Manager</field>
        <field name="implied_ids"
               eval="[(4, ref('group_fitzone_staff')),
                      (4, ref('maintenance.group_equipment_manager'))]"/>
    </record>

    <record id="group_fitzone_technician" model="res.groups">
        <field name="name">FitZone Maintenance Technician</field>
    </record>

    <!-- Fault reports -->

    <record id="rule_fault_report_all" model="ir.rule">
        <field name="name">Fault report: staff and managers see all</field>
        <field name="model_id" ref="model_fitzone_fault_report"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('group_fitzone_staff'))]"/>
    </record>

    <record id="rule_fault_report_technician" model="ir.rule">
        <field name="name">Fault report: technicians see approved only</field>
        <field name="model_id" ref="model_fitzone_fault_report"/>
        <field name="domain_force">[('status', '=', 'approved')]</field>
        <field name="groups"
               eval="[(4, ref('group_fitzone_technician'))]"/>
    </record>

    <!-- Maintenance tickets -->

    <record id="rule_request_manager" model="ir.rule">
        <field name="name">Maintenance request: managers see all</field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('group_fitzone_manager'))]"/>
    </record>

    <record id="rule_request_technician" model="ir.rule">
        <field name="name">
            Maintenance request: technicians see assigned only
        </field>
        <field name="model_id" ref="maintenance.model_maintenance_request"/>
        <field name="domain_force">
            [('user_id', '=', user.id)]
        </field>
        <field name="groups"
               eval="[(4, ref('group_fitzone_technician'))]"/>
    </record>

    <!-- Equipment -->

    <record id="rule_equipment_manager" model="ir.rule">
        <field name="name">
            Equipment: managers and staff see all
        </field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups"
               eval="[(4, ref('group_fitzone_staff'))]"/>
    </record>

    <record id="rule_equipment_technician" model="ir.rule">
        <field name="name">
            Equipment: technicians see equipment of their tickets
        </field>
        <field name="model_id" ref="maintenance.model_maintenance_equipment"/>
        <field name="domain_force">
            [('maintenance_ids.user_id', '=', user.id)]
        </field>
        <field name="groups"
               eval="[(4, ref('group_fitzone_technician'))]"/>
    </record>

</odoo>