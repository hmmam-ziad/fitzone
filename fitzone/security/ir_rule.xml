<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_fitzone_pt_session_trainer" model="ir.rule">
        <field name="name">Trainer: Own PT Sessions</field>
        <field name="model_id" ref="model_fitzone_pt_session" />
        <field name="domain_force">[('trainer_id.employee_id.user_id', '=', user.id)]</field>
        <!-- Replace the former base.group_user assignment on module upgrade. -->
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]" />
    </record>

    <record id="rule_fitzone_partner_trainer" model="ir.rule">
        <field name="name">Trainer: My Trainees List</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="domain_force">[
            '|', '|', '|',
            ('class_booking_ids', 'any', [('class_id.trainer_id.employee_id.user_id', '=', user.id), ('status', '!=', 'cancelled')]),
            ('pt_session_ids.trainer_id.employee_id.user_id', '=', user.id),
            ('id', '=', user.partner_id.id),
            ('id', '=', user.company_id.partner_id.id)
            ]</field>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]" />
    </record>

    <record id="rule_fitzone_pt_session_manager" model="ir.rule">
        <field name="name">Manager: All PT Sessions</field>
        <field name="model_id" ref="model_fitzone_pt_session" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]" />
    </record>

    <record id="rule_fitzone_partner_manager" model="ir.rule">
        <field name="name">Manager: All Trainees</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]" />
    </record>

    <!-- Group rules are additive. These global ceilings prevent other group
         rules from broadening trainer access. Managers retain ordinary access.
         The last leaf is 1 (always true) unless the user is a trainer and not a manager. -->
    <record id="rule_fitzone_pt_session_trainer_ceiling" model="ir.rule">
        <field name="name">Enforce Trainer PT Session Ownership</field>
        <field name="model_id" ref="model_fitzone_pt_session" />
        <field name="groups" eval="[(5, 0, 0)]" />
        <field name="domain_force">['|', ('trainer_id.employee_id.user_id', '=', user.id), ((not
            user.has_group('fitzone.group_fitzone_trainer') or
            any(user.has_group('fitzone.group_fitzone_' + role) for role in ('manager', 'reception'))) and 1 or 0, '=', 1)]</field>
    </record>

    <record id="rule_fitzone_partner_trainer_ceiling" model="ir.rule">
        <field name="name">Enforce Trainer Assigned Trainees</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="groups" eval="[(5, 0, 0)]" />
        <field name="domain_force">['|', '|', '|', '|',
            ('class_booking_ids', 'any', [('class_id.trainer_id.employee_id.user_id', '=', user.id), ('status', '!=', 'cancelled')]),
            ('pt_session_ids.trainer_id.employee_id.user_id', '=', user.id),
            ('id', '=', user.partner_id.id),
            ('id', '=', user.company_id.partner_id.id),
            ((not user.has_group('fitzone.group_fitzone_trainer') or
            any(user.has_group('fitzone.group_fitzone_' + role) for role in ('manager', 'reception', 'physiotherapist', 'nutritionist'))) and 1 or 0, '=', 1)]</field>
    </record>

    <record id="rule_fitzone_health_profile_clinic" model="ir.rule">
        <field name="name">Clinic: Health Profiles</field>
        <field name="model_id" ref="model_fitzone_health_profile" />
        <field name="domain_force">[('member_id', '!=', False)]</field>
        <field name="groups" eval="[(6, 0, [ref('fitzone.group_fitzone_physiotherapist'), ref('fitzone.group_fitzone_nutritionist')])]" />
        <field name="perm_write" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Ownership follows the authenticated creator, not an editable reporter. -->
    <record id="rule_fitzone_injury_trainer_own" model="ir.rule">
        <field name="name">Trainers: Own Injury Reports</field>
        <field name="model_id" ref="model_fitzone_injury" />
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]" />
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_fitzone_injury_clinic_inbox" model="ir.rule">
        <field name="name">Clinic: Submitted Injury Reports</field>
        <field name="model_id" ref="model_fitzone_injury" />
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_physiotherapist')])]" />
        <field name="domain_force">[('state', 'in', ['submitted', 'processed'])]</field>
    </record>

    <!-- Global rules intersect with all group rules and cannot be broadened
         by another group's ACL or record rule. Superuser mode bypasses rules. -->
    <record id="rule_fitzone_rehabilitation_confidentiality" model="ir.rule">
        <field name="name">Rehabilitation: Clinic Only</field>
        <field name="model_id" ref="model_fitzone_rehabilitation" />
        <field name="groups" eval="[(5, 0, 0)]" />
        <field name="domain_force">[((user.has_group('fitzone.group_fitzone_physiotherapist') or user.has_group('fitzone.group_fitzone_manager')) and 1 or 0, '=',
            1)]</field>
    </record>
    <record id="rule_health_assessment_author" model="ir.rule">
        <field name="name">Health assessments: edit own, shared read</field>
        <field name="model_id" ref="model_fitzone_health_profile"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_physiotherapist'), ref('group_fitzone_nutritionist')])]"/>
        <field name="domain_force">[('create_uid', '=', user.id)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_create" eval="False"/>
    </record>
    <record id="rule_partner_reception" model="ir.rule">
        <field name="name">Reception: registration and invoice partners</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_reception')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_partner_sales" model="ir.rule">
        <field name="name">Sales: non-member partners and self</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_sales')])]"/>
        <field name="domain_force">['|', ('id', '=', user.partner_id.id), ('id', 'not in', user.env['res.partner']._sales_hidden_partner_ids())] if user.has_group('fitzone.group_fitzone_sales') and not any(user.has_group('fitzone.group_fitzone_' + role) for role in ('manager', 'reception', 'trainer', 'physiotherapist', 'nutritionist')) else [(1, '=', 1)]</field>
    </record>
    <record id="rule_partner_sales_ceiling" model="ir.rule">
        <field name="name">Sales isolation ceiling (role union)</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="domain_force">['|', ('id', '=', user.partner_id.id), ('id', 'not in', user.env['res.partner']._sales_hidden_partner_ids())] if user.has_group('fitzone.group_fitzone_sales') and not any(user.has_group('fitzone.group_fitzone_' + role) for role in ('manager', 'reception', 'trainer', 'physiotherapist', 'nutritionist')) else [(1, '=', 1)]</field>
    </record>
    <record id="rule_phase4_pt_session" model="ir.rule">
        <field name="name">Phase 4: pt.session scope</field>
        <field name="model_id" ref="model_fitzone_pt_session"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_reception')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_phase4_membership" model="ir.rule">
        <field name="name">Phase 4: membership scope</field>
        <field name="model_id" ref="model_fitzone_membership"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]"/>
        <field name="domain_force">['|', ('member_id.pt_session_ids.trainer_id.employee_id.user_id', '=', user.id), ('member_id.class_booking_ids', 'any', [('class_id.trainer_id.employee_id.user_id', '=', user.id), ('status', '!=', 'cancelled')])]</field>
    </record>
    <record id="rule_phase4_visit" model="ir.rule">
        <field name="name">Phase 4: visit scope</field>
        <field name="model_id" ref="model_fitzone_visit"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]"/>
        <field name="domain_force">['|', ('member_id.pt_session_ids.trainer_id.employee_id.user_id', '=', user.id), ('member_id.class_booking_ids', 'any', [('class_id.trainer_id.employee_id.user_id', '=', user.id), ('status', '!=', 'cancelled')])]</field>
    </record>
    <record id="rule_phase4_class_booking" model="ir.rule">
        <field name="name">Phase 4: class.booking scope</field>
        <field name="model_id" ref="model_fitzone_class_booking"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]"/>
        <field name="domain_force">[('class_id.trainer_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_phase4_attendance" model="ir.rule">
        <field name="name">Phase 4: attendance scope</field>
        <field name="model_id" ref="model_fitzone_attendance"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]"/>
        <field name="domain_force">[('booking_id.class_id.trainer_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_phase4_pool_booking" model="ir.rule">
        <field name="name">Phase 4: pool.booking scope</field>
        <field name="model_id" ref="model_fitzone_pool_booking"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]"/>
        <field name="domain_force">[('trainer_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_phase4_progress_tracking" model="ir.rule">
        <field name="name">Phase 4: progress.tracking scope</field>
        <field name="model_id" ref="model_fitzone_progress_tracking"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]"/>
        <field name="domain_force">[('trainer_id.employee_id.user_id', '=', user.id), ('member_id.pt_session_ids.trainer_id.employee_id.user_id', '=', user.id)]</field>
    </record>
    <record id="rule_phase4_injury_type" model="ir.rule">
        <field name="name">Phase 4: injury.type scope</field>
        <field name="model_id" ref="model_fitzone_injury_type"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_trainer')])]"/>
        <field name="domain_force">['|', ('member_id.pt_session_ids.trainer_id.employee_id.user_id', '=', user.id), ('member_id.class_booking_ids', 'any', [('class_id.trainer_id.employee_id.user_id', '=', user.id), ('status', '!=', 'cancelled')])]</field>
    </record>
    <record id="rule_phase4_membership_other_roles" model="ir.rule">
        <field name="name">Phase 4: membership other authorized roles</field>
        <field name="model_id" ref="model_fitzone_membership"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager'), ref('group_fitzone_reception'), ref('group_fitzone_physiotherapist'), ref('group_fitzone_nutritionist')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_phase4_visit_other_roles" model="ir.rule">
        <field name="name">Phase 4: visit other authorized roles</field>
        <field name="model_id" ref="model_fitzone_visit"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager'), ref('group_fitzone_reception')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_phase4_class_booking_other_roles" model="ir.rule">
        <field name="name">Phase 4: class.booking other authorized roles</field>
        <field name="model_id" ref="model_fitzone_class_booking"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager'), ref('group_fitzone_reception')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_phase4_attendance_other_roles" model="ir.rule">
        <field name="name">Phase 4: attendance other authorized roles</field>
        <field name="model_id" ref="model_fitzone_attendance"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_phase4_pool_booking_other_roles" model="ir.rule">
        <field name="name">Phase 4: pool.booking other authorized roles</field>
        <field name="model_id" ref="model_fitzone_pool_booking"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager'), ref('group_fitzone_reception')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_phase4_progress_tracking_other_roles" model="ir.rule">
        <field name="name">Phase 4: progress.tracking other authorized roles</field>
        <field name="model_id" ref="model_fitzone_progress_tracking"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_phase4_injury_type_other_roles" model="ir.rule">
        <field name="name">Phase 4: injury.type other authorized roles</field>
        <field name="model_id" ref="model_fitzone_injury_type"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_physiotherapist')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_attendance_reception_read" model="ir.rule">
        <field name="name">Reception: attendance read only</field>
        <field name="model_id" ref="model_fitzone_attendance"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_reception')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_partner_medical_read" model="ir.rule">
        <field name="name">Medical roles: member list read</field><field name="model_id" ref="base.model_res_partner"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_physiotherapist'), ref('group_fitzone_nutritionist')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_write" eval="False"/><field name="perm_create" eval="False"/><field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_trainer_product_pricelist_ceiling" model="ir.rule">
        <field name="name">Trainer: no pricing records</field>
        <field name="model_id" ref="product.model_product_pricelist"/>
        <field name="domain_force">[(0, '=', 1)] if user.has_group('fitzone.group_fitzone_trainer') and not any(user.has_group('fitzone.group_fitzone_' + role) for role in ('manager', 'reception', 'sales', 'physiotherapist', 'nutritionist')) else [(1, '=', 1)]</field>
    </record>
    <record id="rule_trainer_product_pricelist_item_ceiling" model="ir.rule">
        <field name="name">Trainer: no pricing records</field>
        <field name="model_id" ref="product.model_product_pricelist_item"/>
        <field name="domain_force">[(0, '=', 1)] if user.has_group('fitzone.group_fitzone_trainer') and not any(user.has_group('fitzone.group_fitzone_' + role) for role in ('manager', 'reception', 'sales', 'physiotherapist', 'nutritionist')) else [(1, '=', 1)]</field>
    </record>
    <record id="rule_task34_injury_manager" model="ir.rule">
        <field name="name">Manager: all injury</field>
        <field name="model_id" ref="model_fitzone_injury"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_task34_injury_type_manager" model="ir.rule">
        <field name="name">Manager: all injury.type</field>
        <field name="model_id" ref="model_fitzone_injury_type"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_task34_rehabilitation_manager" model="ir.rule">
        <field name="name">Manager: all rehabilitation</field>
        <field name="model_id" ref="model_fitzone_rehabilitation"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_task34_health_profile_manager" model="ir.rule">
        <field name="name">Manager: all health.profile</field>
        <field name="model_id" ref="model_fitzone_health_profile"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_task34_nutrition_consultation_manager" model="ir.rule">
        <field name="name">Manager: all nutrition.consultation</field>
        <field name="model_id" ref="model_fitzone_nutrition_consultation"/>
        <field name="groups" eval="[(6, 0, [ref('group_fitzone_manager')])]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_task34_expense_company" model="ir.rule">
        <field name="name">Management expenses: allowed companies</field>
        <field name="model_id" ref="model_fitzone_management_expense"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>