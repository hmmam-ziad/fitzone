<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_fitzone_pt_session_trainer" model="ir.rule">
        <field name="name">Trainer: Own PT Sessions</field>
        <field name="model_id" ref="model_fitzone_pt_session"/>
        <field name="domain_force">
            [('trainer_id.employee_id.user_id', '=', user.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_fitzone_health_profile_clinic" model="ir.rule">
        <field name="name">Clinic: Health Profiles</field>
        <field name="model_id" ref="model_fitzone_health_profile"/>
        <field name="domain_force">[('member_id', '!=', False)]</field>
        <field name="groups" eval="[(4, ref('fitzone.group_fitzone_clinic'))]"/>
    </record>
</odoo>