<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="fitzone.ManagementChart">
        <div class="fz-chart" role="img" t-att-aria-label="props.title">
            <div t-if="props.empty" class="fz-empty"><i class="fa fa-bar-chart" aria-hidden="true"/><p>No data for this period</p></div>
            <canvas t-else="" t-ref="canvas" t-att-aria-label="props.title" role="img"/>
        </div>
    </t>
    <t t-name="fitzone.ManagementDashboard">
        <div class="fz-dashboard" t-att-aria-busy="state.loading">
            <header class="fz-header">
                <div class="fz-title"><span class="fz-eyebrow">FITZONE · LIVE INSIGHTS</span><h1>Management Dashboard</h1><p>Last refreshed <t t-esc="refreshed"/><t t-if="state.data"> · <t t-esc="state.data.company.name"/></t></p></div>
                <div class="fz-filters">
                    <label>Period<select class="form-select" aria-label="Date range" t-att-value="state.preset" t-on-change="changePreset">
                        <option value="today">Today</option><option value="week">This Week</option><option value="month">This Month</option><option value="quarter">This Quarter</option><option value="year">This Year</option><option value="custom">Custom</option>
                    </select></label>
                    <t t-if="state.preset === 'custom'">
                        <label>From<input type="date" class="form-control" aria-label="Start date" t-att-value="state.dateFrom" t-on-change="(ev) => this.changeDate('dateFrom', ev)"/></label>
                        <label>To<input type="date" class="form-control" aria-label="End date" t-att-value="state.dateTo" t-on-change="(ev) => this.changeDate('dateTo', ev)"/></label>
                    </t>
                    <label>Department<select class="form-select" aria-label="Department" t-att-value="state.department" t-on-change="changeDepartment"><option value="">All departments</option><option t-foreach="departments" t-as="dept" t-key="dept[0]" t-att-value="dept[0]"><t t-esc="dept[1]"/></option></select></label>
                    <button class="btn fz-refresh" aria-label="Refresh dashboard" t-on-click="reload" t-att-disabled="state.loading"><i t-att-class="'fa fa-refresh ' + (state.loading ? 'fa-spin' : '')" aria-hidden="true"/> Refresh</button>
                </div>
            </header>
            <main class="fz-content">
                <div t-if="state.error" class="fz-error" role="alert"><i class="fa fa-exclamation-circle" aria-hidden="true"/><h2>We couldn’t load your dashboard</h2><p t-esc="state.error"/><button class="btn btn-primary" t-on-click="reload">Try again</button></div>
                <div t-elif="state.loading" class="fz-skeleton" role="status" aria-label="Loading dashboard"><span class="visually-hidden">Loading dashboard</span><div class="fz-kpis"><div t-foreach="[1,2,3,4,5,6,7,8]" t-as="n" t-key="n" class="fz-shimmer fz-skeleton-card"/></div><div class="fz-grid"><div t-foreach="[1,2,3,4]" t-as="n" t-key="n" class="fz-shimmer fz-panel fz-span-6"/></div></div>
                <t t-elif="state.data">
                    <t t-set="d" t-value="state.data"/><t t-set="c" t-value="charts"/>
                    <div class="fz-kpis"><button t-foreach="cards" t-as="card" t-key="card.key" class="fz-kpi" t-on-click="() => this.drill(card.key)" t-att-aria-label="card.label + ': ' + card.value + '. Open related records'">
                        <span class="fz-kpi-top"><span t-esc="card.label"/><i t-att-class="'fa ' + card.icon" aria-hidden="true"/></span><strong t-esc="card.value"/>
                        <t t-if="card.key === 'total_revenue'"><small>Invoiced / accrual · excludes tax</small>
                            <small>Tax collected: <t t-esc="number(d.tax_collected, 'money')"/></small>
                            <small>Total incl. tax: <t t-esc="number(d.total_incl_tax, 'money')"/></small>
                        </t>
                        <span t-att-class="'fz-trend ' + (card.good ? 'fz-positive' : 'fz-negative')"><i t-att-class="'fa ' + (card.trend > 0 ? 'fa-arrow-up' : card.trend &lt; 0 ? 'fa-arrow-down' : 'fa-minus')" aria-hidden="true"/> <t t-esc="card.trendLabel"/></span><small> vs previous period</small>
                    </button></div>
                    <div class="fz-period-note"><t t-esc="d.date_from"/> — <t t-esc="d.date_to"/> <span>compared with <t t-esc="d.previous_from"/> — <t t-esc="d.previous_to"/></span></div>
                    <div class="fz-grid">
                        <section class="fz-panel fz-span-8"><div class="fz-panel-heading"><div><h2>Revenue vs Expenses</h2><p>Performance by department · <t t-esc="d.currency"/></p></div><button class="fz-link" t-on-click="() => this.drill('net_revenue')">Explore sources <i class="fa fa-arrow-right" aria-hidden="true"/></button></div><DashboardChart title="'Revenue versus expenses by department'" config="c.finances" empty="!hasFinance"/></section>
                        <section class="fz-panel fz-span-4"><h2>Revenue share</h2><p>Department contribution · positive revenue</p><DashboardChart title="'Revenue share by department'" config="c.share" empty="!hasRevenue"/></section>
                        <section class="fz-panel fz-span-7"><h2>Revenue &amp; expenses trend</h2><p t-esc="performanceLabel(d)"/><DashboardChart title="'Revenue and expenses over time'" config="c.trend" empty="!hasFinance"/></section>
                        <section class="fz-panel fz-span-5"><h2>Net revenue by department</h2><p>After manual and purchase expenses</p><div t-if="!hasFinance" class="fz-empty">No data for this period</div><div t-else="" class="fz-table-wrap"><table class="fz-table"><thead><tr><th>Department</th><th>Manual expenses</th><th>Purchase expenses</th><th>Total expenses</th><th>Net revenue</th><th>Margin</th></tr></thead><tbody><tr t-foreach="d.departments" t-as="r" t-key="r.key" role="button" tabindex="0" t-on-click="() => this.drill('net_revenue', { department: r.key })" t-on-keydown="(ev) => this.rowKey(ev, 'net_revenue', { department: r.key })"><td t-esc="r.name"/><td t-on-click.stop="() => this.drill('manual_expenses', { department: r.key })" t-esc="number(r.manual_expenses, 'money')"/><td t-on-click.stop="() => this.drill('purchase_expenses', { department: r.key })" t-esc="number(r.purchase_expenses, 'money')"/><td t-on-click.stop="() => this.drill('total_expenses', { department: r.key })" t-esc="number(r.total_expenses, 'money')"/><td t-att-class="r.net &lt; 0 ? 'fz-negative' : ''" t-esc="number(r.net, 'money')"/><td><span t-esc="number(r.margin, 'percent')"/><div class="fz-progress"><span t-att-style="width(r.margin)"/></div></td></tr></tbody></table></div></section>
                        <section class="fz-panel fz-span-6"><h2>Collected by Department · Cash basis</h2>
                            <p>Cash receipts allocated using tax-exclusive line shares · includes tax</p>
                            <button class="fz-link" t-on-click="() => this.drill('collected_cash')">Open report · <t t-esc="number(d.collected_cash, 'money')"/></button>
                            <div class="fz-table-wrap"><table class="fz-table"><thead><tr><th>Department</th><th>Collected cash</th></tr></thead>
                                <tbody><tr t-foreach="d.collected" t-as="r" t-key="r.key" role="button" tabindex="0" t-on-click="() => this.drill('collected_cash', { department: r.key })" t-on-keydown="(ev) => this.rowKey(ev, 'collected_cash', { department: r.key })"><td t-esc="r.name"/><td t-esc="number(r.collected_cash, 'money')"/></tr></tbody>
                            </table></div>
                        </section>
                        <section class="fz-panel fz-span-6"><h2>Hall &amp; Studio occupancy</h2><p>Booked &amp; attended seats / available seats</p><div t-if="!hasOccupancy" class="fz-empty">No data for this period</div><div t-else="" class="fz-occupancy"><div t-foreach="d.halls" t-as="r" t-key="r.room_id" class="fz-room" role="button" tabindex="0" t-on-click="() => this.drill('overall_occupancy_percent', { room: r.room_id })" t-on-keydown="(ev) => this.rowKey(ev, 'overall_occupancy_percent', { room: r.room_id })"><div class="fz-room-heading"><strong t-esc="r.name"/><span t-if="r.flag" class="fz-badge" t-esc="r.flag"/><b t-esc="number(r.occupancy_percent, 'percent')"/></div><div t-att-class="'fz-progress ' + occupancyClass(r.occupancy_percent)" role="progressbar" aria-label="Hall occupancy" aria-valuemin="0" aria-valuemax="100" t-att-aria-valuenow="Math.min(100, r.occupancy_percent)"><span t-att-style="width(r.occupancy_percent)"/></div><small><t t-esc="r.booked_seats"/> / <t t-esc="r.offered_seats"/> seats · <t t-esc="number(r.utilization_percent, 'percent')"/> of opening hours scheduled</small></div></div></section>
                        <section class="fz-panel fz-span-6"><h2>Trainer &amp; specialist workload</h2><p>Sessions vs prorated monthly quota</p><DashboardChart title="'Trainer sessions versus quota'" config="c.workload" empty="!d.workload.some(r => r.sessions || r.quota)"/><div class="fz-workload"><button class="fz-link" t-foreach="d.workload" t-as="r" t-key="r.id" t-on-click="() => this.drill('workload', { trainer: r.id })"><t t-esc="r.name"/>: <strong t-esc="r.completion_percent === null ? 'No target' : number(r.completion_percent, 'percent')"/></button></div></section>
                        <section class="fz-panel fz-span-4"><h2>Injuries by cause</h2><p><button class="fz-link" t-on-click="() => this.drill('injuries_count')"><t t-esc="number(d.kpis.injuries_count)"/> reported injuries · View records</button></p><DashboardChart title="'Injuries by cause'" config="c.causes" empty="!d.injuries_by_cause.length"/></section>
                        <section class="fz-panel fz-span-4"><h2>Injuries by sport</h2><p>Distinct injuries per sport; an injury may have several sports</p><DashboardChart title="'Injuries by sport type'" config="c.sports" empty="!d.injuries_by_sport.length"/></section>
                        <section class="fz-panel fz-span-4"><h2>Cross-department conversion</h2><button class="fz-conversion" t-on-click="() => this.drill('cross_conversion_percent')" aria-label="View members using multiple departments"><strong t-esc="number(d.kpis.cross_conversion_percent, 'percent')"/><span>of <t t-esc="number(d.conversion_members)"/> members use 2+ departments</span></button><div class="fz-progress"><span t-att-style="width(d.kpis.cross_conversion_percent)"/></div><div t-if="!d.conversion_members" class="fz-empty">No data for this period</div><div t-else="" class="fz-table-wrap"><table class="fz-table fz-matrix" aria-label="Shared members between departments"><thead><tr><th>Members</th><th t-foreach="departments" t-as="dept" t-key="dept[0]" t-att-title="dept[1]" t-esc="dept[1]"/></tr></thead><tbody><tr t-foreach="departments" t-as="source" t-key="source[0]"><th t-esc="source[1]"/><td t-foreach="departments" t-as="target" t-key="target[0]" role="button" tabindex="0" t-on-click="() => this.drill('cross_conversion_percent', { matrix_source: source[0], matrix_target: target[0] })" t-on-keydown="(ev) => this.rowKey(ev, 'cross_conversion_percent', { matrix_source: source[0], matrix_target: target[0] })" t-att-class="source[0] === target[0] ? 'fz-diagonal' : ''" t-esc="matrixCount(source[0],target[0])"/></tr></tbody></table></div></section>
                        <section class="fz-panel fz-span-4"><h2>Membership health</h2><p><button class="fz-link" t-on-click="() => this.drill('active_memberships')">Active: <t t-esc="number(d.memberships.active)"/></button> · <button class="fz-link" t-on-click="() => this.drill('expired_memberships')">Expired: <t t-esc="number(d.memberships.expired)"/></button></p><DashboardChart title="'Active versus expired memberships'" config="c.memberships" empty="!(d.memberships.active || d.memberships.expired)"/></section>
                        <section class="fz-panel fz-span-4"><h2>Installments</h2><p>Pending collections · relative to range end</p><div t-if="!(d.upcoming.count || d.overdue.count)" class="fz-empty">No data for this period</div><div t-else="" class="fz-installments"><button class="fz-installment fz-upcoming" t-on-click="() => this.drill('upcoming_installments_amount')"><span><i class="fa fa-calendar" aria-hidden="true"/> Upcoming <b t-esc="number(d.upcoming.count)"/></span><strong t-esc="number(d.upcoming.amount,'money')"/><small>Within one period after range end</small></button><button class="fz-installment fz-overdue" t-on-click="() => this.drill('overdue_installments_amount')"><span><i class="fa fa-clock-o" aria-hidden="true"/> Overdue <b t-esc="number(d.overdue.count)"/></span><strong t-esc="number(d.overdue.amount,'money')"/><small>Due within the selected period</small></button></div></section>
                        <section class="fz-panel fz-span-4"><h2>Oldest overdue installments</h2><p>Top 5 · follow up on collections</p><div t-if="!d.top_overdue.length" class="fz-empty">No data for this period</div><div t-else="" class="fz-overdue-list"><button t-foreach="d.top_overdue" t-as="item" t-key="item.id" t-on-click="() => this.openInstallment(item.id)"><span><strong t-esc="item.name"/><small t-esc="item.due_date"/></span><b t-esc="number(item.amount,'money')"/><i class="fa fa-angle-right" aria-hidden="true"/></button></div></section>
                    </div>
                    <details class="fz-basis"><summary>How these live metrics are calculated</summary><p t-esc="d.basis"/></details>

                </t>
            </main>
        </div>
    </t>
</templates>
