            <attribute name="t-if" add="!fitzoneHideAdminUI" separator=" and "/>
        </xpath>
        <xpath expr="//a[@t-if='!isAssets']" position="attributes">
            <attribute name="t-if" add="!fitzoneHideAdminUI" separator=" and "/>
        </xpath>
        <xpath expr="//a[@t-if='!isTests']" position="attributes">
            <attribute name="t-if" add="!fitzoneHideAdminUI" separator=" and "/>
        </xpath>
        <xpath expr="//a[@t-if='isDebug']" position="attributes">
            <attribute name="t-if" add="!fitzoneHideAdminUI" separator=" and "/>
        </xpath>
    </t>
</templates>
