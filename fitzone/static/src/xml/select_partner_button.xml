<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.SelectPartnerButton" t-inherit-mode="extension">
        <xpath expr="//div[@t-if='props.partner']" position="replace">
            <div t-if="props.partner" class="text-truncate text-action">
                <t t-esc="props.partner.name"/>
                <span t-if="props.partner.membership_status">
                    - <t t-esc="props.partner.membership_status"/>
                </span>
            </div>
        </xpath>
    </t>
</templates>
