<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Installment Plans -->
    <record id="view_fitzone_installment_plan_list" model="ir.ui.view">
        <field name="name">fitzone.installment.plan.list</field>
        <field name="model">fitzone.installment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="membership_id"/>
                <field name="total_amount"/>
                <field name="down_payment"/>
                <field name="status"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_installment_plan_form" model="ir.ui.view">
        <field name="name">fitzone.installment.plan.form</field>
        <field name="model">fitzone.installment.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <group>
                    <field name="membership_id"/>
                    <field name="total_amount"/>
                    <field name="down_payment"/>
                    <field name="status"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                <notebook>
                        <page string="Installment">
                            <field name="installment_ids"/>
                        </page>
                </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_installment_plan" model="ir.actions.act_window">
        <field name="name">Installment Plans</field>
        <field name="res_model">fitzone.installment.plan</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Installments -->
    <record id="view_fitzone_installment_list" model="ir.ui.view">
        <field name="name">fitzone.installment.list</field>
        <field name="model">fitzone.installment</field>
        <field name="arch" type="xml">
            <list>
                <field name="plan_id"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="status"/>
                <field name="currency_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_installment_form" model="ir.ui.view">
        <field name="name">fitzone.installment.form</field>
        <field name="model">fitzone.installment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <group>
                    <field name="plan_id"/>
                    <field name="due_date"/>
                    <field name="amount"/>
                    <field name="status"/>
                    <field name="currency_id" invisible="1"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_installment" model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">fitzone.installment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>