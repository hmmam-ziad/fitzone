<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Reception can read linked invoice headers, but not accounting lines.
         This standalone view does not inherit accounting actions or chatter. -->
    <record id="view_membership_invoice_readonly" model="ir.ui.view">
        <field name="name">fitzone.membership.invoice.readonly</field>
        <field name="model">account.move</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Membership Invoice" create="0" edit="0" delete="0" duplicate="0">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="invoice_date"/>
                        <field name="invoice_date_due"/>
                        <field name="state"/>
                        <field name="payment_state"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount_total"/>
                        <field name="amount_residual"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Installment Plans -->
    <record id="view_fitzone_installment_plan_list" model="ir.ui.view">
        <field name="name">fitzone.installment.plan.list</field>
        <field name="model">fitzone.installment.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="membership_id"/>
                <field name="total_amount"/>
                <field name="down_payment"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_installment_plan_form" model="ir.ui.view">
        <field name="name">fitzone.installment.plan.form</field>
        <field name="model">fitzone.installment.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_schedule"
                            type="object"
                            string="Generate Installment Schedule"
                            class="btn-primary"
                            invisible="status != 'draft'"/>
                </header>
                <sheet>
                    <group>
                        <field name="membership_id"
                               readonly="status != 'draft'"/>
                        <field name="total_amount" readonly="1"/>
                        <field name="down_payment"
                               readonly="status != 'draft'"/>
                        <field name="status" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Installments">
                            <field name="installment_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="due_date"/>
                                    <field name="amount"/>
                                    <field name="status"/>
                                    <field name="is_overdue"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_installment_plan"
            model="ir.actions.act_window">
        <field name="name">Installment Plans</field>
        <field name="res_model">fitzone.installment.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Installments -->
    <record id="view_fitzone_installment_list" model="ir.ui.view">
        <field name="name">fitzone.installment.list</field>
        <field name="model">fitzone.installment</field>
        <field name="arch" type="xml">
            <list>
                <field name="plan_id"/>
                <field name="due_date"/>
                <field name="amount"/>
                <field name="status"/>
                <field name="is_overdue"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_installment_form" model="ir.ui.view">
        <field name="name">fitzone.installment.form</field>
        <field name="model">fitzone.installment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_register_payment"
                            type="object"
                            string="Register Payment"
                            class="btn-primary"
                            invisible="status != 'pending'"/>
                </header>
                <sheet>
                    <group>
                        <field name="plan_id" readonly="1"/>
                        <field name="due_date" readonly="1"/>
                        <field name="amount" readonly="1"/>
                        <field name="status" readonly="1"/>
                        <field name="payment_id" readonly="1"/>
                        <field name="is_overdue" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_installment"
            model="ir.actions.act_window">
        <field name="name">Installments</field>
        <field name="res_model">fitzone.installment</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
