<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Package fields on the product form (product.template) -->
    <record id="view_product_template_form_fitzone" model="ir.ui.view">
        <field name="name">product.template.form.fitzone</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="FitZone Package">

                    <group>
                        <field name="package_type" />
                        <field name="duration_months" />
                        <field name="total_sessions" />
                    </group>

                    <group string="Allowed Class Days">
                        <field name="allow_mon" />
                        <field name="allow_tue" />
                        <field name="allow_wed" />
                        <field name="allow_thu" />
                        <field name="allow_fri" />
                        <field name="allow_sat" />
                        <field name="allow_sun" />
                    </group>

                    <!-- Time window allowed by the package -->
                    <group string="Allowed Class Time">
                        <field name="allowed_from" widget="float_time" />
                        <field name="allowed_to" widget="float_time" />
                    </group>

                </page>
            </xpath>

        </field>
    </record>


    <!-- ========================================== -->
    <!-- Memberships Views & Search -->
    <!-- ========================================== -->
    <record id="view_fitzone_membership_search" model="ir.ui.view">
        <field name="name">fitzone.membership.search</field>
        <field name="model">fitzone.membership</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id" />
                <field name="package_id" />
                <field name="barcode" />
                <separator />
                <filter string="Draft" name="filter_draft"
                    domain="[('state', '=', 'draft')]" />
                <filter string="Active" name="filter_active"
                    domain="[('state', '=', 'active')]" />
                <filter string="Blocked" name="filter_blocked"
                    domain="[('state', '=', 'blocked')]" />
                <filter string="Expired" name="filter_expired"
                    domain="[('state', '=', 'expired')]" />
                <filter string="Cancelled" name="filter_cancelled"
                    domain="[('state', '=', 'cancelled')]" />
                <separator />
                <filter string="Expiring in 7 Days" name="filter_expiring_soon"
                    domain="[('state', '=', 'active'),
                             ('date_end', '&gt;=', context_today().strftime('%Y-%m-%d')),
                             ('date_end', '&lt;=', (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]" />
                <separator />
                <filter string="Member" name="group_by_member"
                    context="{'group_by': 'member_id'}" />
                <filter string="Package" name="group_by_package"
                    context="{'group_by': 'package_id'}" />
                <filter string="Status" name="group_by_state"
                    context="{'group_by': 'state'}" />
                <filter string="End Date" name="group_by_date_end"
                    context="{'group_by': 'date_end:month'}" />
            </search>
        </field>
    </record>

    <record id="view_fitzone_membership_list" model="ir.ui.view">
        <field name="name">fitzone.membership.list</field>
        <field name="model">fitzone.membership</field>
        <field name="arch" type="xml">

            <list
                decoration-muted="state in ('expired', 'cancelled')"
                decoration-danger="state == 'blocked'">

                <field name="member_id" />
                <field name="package_id" />
                <field name="base_price" />
                <field name="all_inclusive" />
                <field name="final_price" />
                <field name="barcode" />
                <field name="date_start" />
                <field name="date_end" />

                <field name="state"
                    widget="badge"
                    decoration-success="state == 'active'"
                    decoration-danger="state == 'blocked'" />

            </list>

        </field>
    </record>

    <!-- Membership Form -->
    <record id="view_fitzone_membership_form" model="ir.ui.view">
        <field name="name">fitzone.membership.form</field>
        <field name="model">fitzone.membership</field>
        <field name="arch" type="xml">

            <form>

                <header>

                    <!-- Create invoice for a non-installment membership -->
                    <button
                        name="action_create_invoice"
                        type="object"
                        string="Create Invoice"
                        invisible="state != 'draft' or invoice_id"
                    />

                    <button name="action_membership_payment" type="object"
                        string="Register Payment"
                        groups="fitzone.group_fitzone_reception,fitzone.group_fitzone_manager"
                        invisible="state != 'draft' or not invoice_id"/>

                    <!-- Activate draft membership -->
                    <button
                        name="action_activate"
                        type="object"
                        string="Activate"
                        class="btn-primary"
                        invisible="state != 'draft'"
                    />

                    <!-- Block active membership -->
                    <button
                        name="action_block"
                        type="object"
                        string="Block"
                        invisible="state != 'active'"
                    />

                    <!-- Unblock blocked membership -->
                    <button
                        name="action_unblock"
                        type="object"
                        string="Unblock"
                        class="btn-primary"
                        invisible="state != 'blocked'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="draft,active,blocked,expired"
                    />

                </header>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_installment_plans" type="object" class="oe_stat_button fz-smart-button fz-smart-purple" icon="fa-list-alt" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception">
                            <field name="installment_plan_count" widget="statinfo" string="Installment Plan"/>
                        </button>
                        <button name="action_view_due_installments" type="object" class="oe_stat_button fz-smart-button fz-smart-warning" icon="fa-clock-o" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception">
                            <field name="due_installment_count" widget="statinfo" string="Due Installments"/>
                        </button>
                        <button name="action_view_membership_invoice" type="object" class="oe_stat_button fz-smart-button fz-smart-teal" icon="fa-file-text-o" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception" invisible="not invoice_id">
                            <span class="o_stat_text">Invoice</span>
                        </button>
                    </div>

                    <group>

                        <group>
                            <field name="member_id" />
                            <field name="package_id" />
                            <field name="barcode" />
                            <field name="barcode_image" widget="image" string="Membership Barcode"
                                readonly="1" invisible="not barcode" options="{'size': [400, 120]}" />
                            <field name="base_price" readonly="1" />
                            <field name="all_inclusive" />
                            <field name="final_price" readonly="1" />
                            <field name="package_type" invisible="1" />
                            <field name="invoice_id" readonly="1" options="{'no_open': True}" />

                            <field name="total_sessions"
                                readonly="1"
                                invisible="package_type != 'private'" />

                            <field name="consumed_sessions"
                                invisible="package_type != 'private'" />

                            <field name="remaining_sessions"
                                readonly="1"
                                invisible="package_type != 'private'" />
                        </group>

                        <group>
                            <field name="date_start" readonly="1" />
                            <field name="date_end" readonly="1" />

                            <field
                                name="block_reason"
                                invisible="state != 'blocked'"
                            />
                        </group>

                    </group>

                    <group string="All-Inclusive Medical Credits"
                        invisible="not all_inclusive">
                        <group string="Physiotherapy">
                            <field name="physio_sessions_total" />
                            <field name="physio_sessions_consumed" />
                            <field name="physio_sessions_remaining" />
                        </group>
                        <group string="Nutrition">
                            <field name="nutrition_sessions_total" />
                            <field name="nutrition_sessions_consumed" />
                            <field name="nutrition_sessions_remaining" />
                        </group>
                    </group>

                </sheet>

            </form>

        </field>
    </record>

    <!-- Membership Action -->
    <record id="action_fitzone_membership" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">fitzone.membership</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fitzone_membership_search" />
        <field name="context">{'search_default_filter_active': 1}</field>
    </record>


    <!-- ========================================== -->
    <!-- Freezes Views & Search -->
    <!-- ========================================== -->
    <record id="view_fitzone_freeze_search" model="ir.ui.view">
        <field name="name">fitzone.freeze.search</field>
        <field name="model">fitzone.freeze</field>
        <field name="arch" type="xml">
            <search>
                <field name="membership_id" />
                <field name="start_date" />
                <separator />
                <filter string="Currently Frozen" name="filter_current"
                    domain="[('start_date', '&lt;=', context_today().strftime('%Y-%m-%d')),
                             ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]" />
                <filter string="Upcoming" name="filter_upcoming"
                    domain="[('start_date', '&gt;', context_today().strftime('%Y-%m-%d'))]" />
                <filter string="Past" name="filter_past"
                    domain="[('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]" />
                <separator />
                <filter string="Membership" name="group_by_membership"
                    context="{'group_by': 'membership_id'}" />
                <filter string="Start Date" name="group_by_start"
                    context="{'group_by': 'start_date:month'}" />
            </search>
        </field>
    </record>

    <record id="view_fitzone_freeze_list" model="ir.ui.view">
        <field name="name">fitzone.freeze.list</field>
        <field name="model">fitzone.freeze</field>
        <field name="arch" type="xml">

            <list>
                <field name="membership_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="days" />
            </list>

        </field>
    </record>

    <!-- Freeze Form -->
    <record id="view_fitzone_freeze_form" model="ir.ui.view">
        <field name="name">fitzone.freeze.form</field>
        <field name="model">fitzone.freeze</field>
        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="membership_id" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="days" />
                    </group>

                </sheet>
            </form>

        </field>
    </record>

    <!-- Freeze Action -->
    <record id="action_fitzone_freeze" model="ir.actions.act_window">
        <field name="name">Freezes</field>
        <field name="res_model">fitzone.freeze</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fitzone_freeze_search" />
    </record>

</odoo>