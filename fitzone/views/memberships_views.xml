<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Package fields on the product form (product.template) -->
    <record id="view_product_template_form_fitzone" model="ir.ui.view">
        <field name="name">product.template.form.fitzone</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="FitZone Package">

                    <group>
                        <field name="package_type" />
                        <field name="duration_months" />
                        <field name="total_sessions" />
                    </group>

                    <group string="Allowed Class Days">
                        <field name="allow_mon" />
                        <field name="allow_tue" />
                        <field name="allow_wed" />
                        <field name="allow_thu" />
                        <field name="allow_fri" />
                        <field name="allow_sat" />
                        <field name="allow_sun" />
                    </group>

                    <!-- Time window allowed by the package -->
                    <group string="Allowed Class Time">
                        <field name="allowed_from" widget="float_time" />
                        <field name="allowed_to" widget="float_time" />
                    </group>

                </page>
            </xpath>

        </field>
    </record>


    <!-- Memberships -->
    <record id="view_fitzone_membership_list" model="ir.ui.view">
        <field name="name">fitzone.membership.list</field>
        <field name="model">fitzone.membership</field>
        <field name="arch" type="xml">

            <list
                decoration-muted="state in ('expired', 'cancelled')"
                decoration-danger="state == 'blocked'">

                <field name="member_id" />
                <field name="package_id" />
                <field name="barcode" />
                <field name="date_start" />
                <field name="date_end" />

                <field name="state"
                    widget="badge"
                    decoration-success="state == 'active'"
                    decoration-danger="state == 'blocked'" />

            </list>

        </field>
    </record>


    <!-- Membership Form -->
    <record id="view_fitzone_membership_form" model="ir.ui.view">
        <field name="name">fitzone.membership.form</field>
        <field name="model">fitzone.membership</field>
        <field name="arch" type="xml">

            <form>

                <header>

                    <!-- Block active membership -->
                    <button
                        name="action_block"
                        type="object"
                        string="Block"
                        invisible="state != 'active'"
                    />

                    <!-- Unblock blocked membership -->
                    <button
                        name="action_unblock"
                        type="object"
                        string="Unblock"
                        class="btn-primary"
                        invisible="state != 'blocked'"
                    />

                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="active,blocked,expired"
                    />

                </header>

                <sheet>

                    <group>

                        <group>
                            <field name="member_id" />
                            <field name="package_id" />
                            <field name="barcode" />
                        </group>

                        <group>
                            <field name="date_start" />
                            <field name="date_end" />

                            <field
                                name="block_reason"
                                invisible="state != 'blocked'"
                            />
                        </group>

                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Membership Action -->
    <record id="action_fitzone_membership" model="ir.actions.act_window">
        <field name="name">Memberships</field>
        <field name="res_model">fitzone.membership</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Freezes -->
    <record id="view_fitzone_freeze_list" model="ir.ui.view">
        <field name="name">fitzone.freeze.list</field>
        <field name="model">fitzone.freeze</field>
        <field name="arch" type="xml">

            <list>
                <field name="membership_id" />
                <field name="start_date" />
                <field name="end_date" />
                <field name="days" />
            </list>

        </field>
    </record>


    <!-- Freeze Form -->
    <!-- t -->
    <record id="view_fitzone_freeze_form" model="ir.ui.view">
        <field name="name">fitzone.freeze.form</field>
        <field name="model">fitzone.freeze</field>
        <field name="arch" type="xml">

            <form>
                <sheet>

                    <group>
                        <field name="membership_id" />
                        <field name="start_date" />
                        <field name="end_date" />
                        <field name="days" />
                    </group>

                </sheet>
            </form>

        </field>
    </record>


    <!-- Freeze Action -->
    <record id="action_fitzone_freeze" model="ir.actions.act_window">
        <field name="name">Freezes</field>
        <field name="res_model">fitzone.freeze</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>