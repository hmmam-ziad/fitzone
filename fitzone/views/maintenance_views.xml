<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================== -->
    <!-- Equipment: search (extra filters) -->
    <!-- ========================================== -->
    <record id="view_equipment_search_fitzone" model="ir.ui.view">
        <field name="name">maintenance.equipment.search.fitzone</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator />
                <filter string="In Service" name="filter_in_service"
                    domain="[('status', '=', 'in_service')]" />
                <filter string="Out of Service" name="filter_out_of_service"
                    domain="[('status', '=', 'out_of_service')]" />
                <separator />
                <filter string="Service Status" name="group_by_fitzone_status"
                    context="{'group_by': 'status'}" />
                <filter string="Vendor" name="group_by_fitzone_vendor"
                    context="{'group_by': 'vendor_id'}" />
            </xpath>
        </field>
    </record>

    <!-- Equipment: list (red when out of service) -->
    <record id="view_equipment_list_fitzone" model="ir.ui.view">
        <field name="name">maintenance.equipment.list.fitzone</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_tree" />
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="decoration-danger">status == 'out_of_service'</attribute>
            </xpath>
            <xpath expr="//field[@name='name']" position="after">
                <field name="status" widget="badge"
                    decoration-success="status == 'in_service'"
                    decoration-danger="status == 'out_of_service'" />
            </xpath>
        </field>
    </record>

    <!-- Equipment: form -->
    <record id="view_equipment_form_fitzone" model="ir.ui.view">
        <field name="name">maintenance.equipment.form.fitzone</field>
        <field name="model">maintenance.equipment</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_return_to_service" type="object"
                        string="Return to Service" class="btn-primary"
                        groups="fitzone.group_fitzone_manager"
                        invisible="status != 'out_of_service'"
                        confirm="Return this equipment to service?" />
                    <field name="status" widget="statusbar" />
                </header>
            </xpath>
            <xpath expr="//field[@name='maintenance_team_id']" position="after">
                <field name="vendor_id" />
                <field name="period" />
            </xpath>
        </field>
    </record>

    <!-- Maintenance ticket: extra fields -->
    <record id="view_request_form_fitzone" model="ir.ui.view">
        <field name="name">maintenance.request.form.fitzone</field>
        <field name="model">maintenance.request</field>
        <field name="inherit_id" ref="maintenance.hr_equipment_request_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='equipment_id']" position="after">
                <field name="fault_id" />
                <field name="vendor_id" groups="fitzone.group_fitzone_manager" />
                <field name="estimated_cost" groups="fitzone.group_fitzone_manager" />
            </xpath>
        </field>
    </record>


    <!-- ========================================== -->
    <!-- Fault Reports Views & Search -->
    <!-- ========================================== -->
    <record id="view_fitzone_fault_report_search" model="ir.ui.view">
        <field name="name">fitzone.fault.report.search</field>
        <field name="model">fitzone.fault.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id" />
                <field name="serial_no" />
                <field name="reported_by" />
                <field name="member_id" />
                <field name="technician_id" />
                <field name="vendor_id" />
                <separator />
                <filter string="Reported" name="filter_reported"
                    domain="[('status', '=', 'reported')]" />
                <filter string="Approved" name="filter_approved"
                    domain="[('status', '=', 'approved')]" />
                <filter string="Rejected" name="filter_rejected"
                    domain="[('status', '=', 'rejected')]" />
                <separator />
                <filter string="Last 7 Days" name="filter_last_7_days"
                    domain="[('report_date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]" />
                <separator />
                <filter string="Equipment" name="group_by_equipment"
                    context="{'group_by': 'equipment_id'}" />
                <filter string="Reported By" name="group_by_reported_by"
                    context="{'group_by': 'reported_by'}" />
                <filter string="Member" name="group_by_member"
                    context="{'group_by': 'member_id'}" />
                <filter string="Vendor" name="group_by_vendor"
                    context="{'group_by': 'vendor_id'}" />
                <filter string="Status" name="group_by_status"
                    context="{'group_by': 'status'}" />
                <filter string="Report Date" name="group_by_report_date"
                    context="{'group_by': 'report_date:month'}" />
            </search>
        </field>
    </record>

    <record id="view_fitzone_fault_report_list" model="ir.ui.view">
        <field name="name">fitzone.fault.report.list</field>
        <field name="model">fitzone.fault.report</field>
        <field name="arch" type="xml">
            <list decoration-danger="status == 'reported'"
                decoration-muted="status == 'rejected'">
                <field name="equipment_id" />
                <field name="serial_no" />
                <field name="reported_by" />
                <field name="member_id" />
                <field name="report_date" />
                <field name="status" widget="badge" />
            </list>
        </field>
    </record>

    <record id="view_fitzone_fault_report_form" model="ir.ui.view">
        <field name="name">fitzone.fault.report.form</field>
        <field name="model">fitzone.fault.report</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" type="object" string="Approve"
                        class="btn-primary" groups="fitzone.group_fitzone_manager"
                        invisible="status != 'reported'" />
                    <button name="action_reject" type="object" string="Reject"
                        groups="fitzone.group_fitzone_manager"
                        invisible="status != 'reported'" />
                    <field name="status" widget="statusbar" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id" readonly="id" />
                            <field name="serial_no" />
                            <field name="reported_by" readonly="id" />
                            <field name="member_id" readonly="id" />
                            <field name="report_date" />
                        </group>
                        <group>
                            <field name="description" readonly="id" />
                        </group>
                    </group>
                    <group string="Management Review"
                        groups="fitzone.group_fitzone_manager">
                        <group>
                            <field name="technician_id" readonly="status != 'reported'" />
                            <field name="vendor_id" readonly="status != 'reported'" />
                            <field name="estimated_cost" readonly="status != 'reported'" />
                            <field name="expected_date" readonly="status != 'reported'" />
                        </group>
                        <group>
                            <field name="reject_reason" readonly="status != 'reported'" />
                            <field name="request_id" />
                        </group>
                    </group>
                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_fitzone_fault_report" model="ir.actions.act_window">
        <field name="name">Fault Reports</field>
        <field name="res_model">fitzone.fault.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fitzone_fault_report_search" />
        <field name="context">{'search_default_filter_reported': 1}</field>
    </record>

</odoo>