<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Trainers -->
    <record id="view_fitzone_trainer_list" model="ir.ui.view">
        <field name="name">fitzone.trainer.list</field>
        <field name="model">fitzone.trainer</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="specialty"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_trainer_form" model="ir.ui.view">
        <field name="name">fitzone.trainer.form</field>
        <field name="model">fitzone.trainer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <group>
                    <field name="employee_id"/>
                    <field name="specialty"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_trainer" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">fitzone.trainer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>