<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Trainers -->
    <record id="view_fitzone_trainer_list" model="ir.ui.view">
        <field name="name">fitzone.trainer.list</field>
        <field name="model">fitzone.trainer</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="specialty"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_trainer_form" model="ir.ui.view">
        <field name="name">fitzone.trainer.form</field>
        <field name="model">fitzone.trainer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="can_view_assignments" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_schedule" type="object" class="oe_stat_button fz-smart-button fz-smart-indigo" icon="fa-calendar" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception,fitzone.group_fitzone_trainer" invisible="not can_view_assignments">
                            <span class="o_stat_text">Schedule</span>
                        </button>
                        <button name="action_view_trainees" type="object" class="oe_stat_button fz-smart-button fz-smart-teal" icon="fa-users" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception,fitzone.group_fitzone_trainer" invisible="not can_view_assignments">
                            <field name="trainee_count" widget="statinfo" string="Trainees"/>
                        </button>
                    </div>
                <group>
                    <field name="employee_id"/>
                    <field name="specialty"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_trainer" model="ir.actions.act_window">
        <field name="name">Trainers</field>
        <field name="res_model">fitzone.trainer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>