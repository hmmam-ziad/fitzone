<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ==================== Pool Slots ==================== -->

    <record id="view_fitzone_pool_slot_list" model="ir.ui.view">
        <field name="name">fitzone.pool.slot.list</field>
        <field name="model">fitzone.pool.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="day_of_week" />
                <field name="start_time" widget="float_time" />
                <field name="end_time" widget="float_time" />
                <field name="capacity" />
                <field name="slot_type" />
            </list>
        </field>
    </record>

    <record id="view_fitzone_pool_slot_form" model="ir.ui.view">
        <field name="name">fitzone.pool.slot.form</field>
        <field name="model">fitzone.pool.slot</field>
        <field name="arch" type="xml">
            <form string="Pool Slot">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_bookings" type="object" class="oe_stat_button fz-smart-button fz-smart-cyan" icon="fa-ticket" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception,fitzone.group_fitzone_trainer">
                            <field name="booking_count" widget="statinfo" string="Bookings"/>
                        </button>
                    </div>
                    <group>
                        <field name="day_of_week" />
                        <field name="start_time" widget="float_time" />
                        <field name="end_time" widget="float_time" />
                        <field name="capacity" />
                        <field name="slot_type" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_pool_slot" model="ir.actions.act_window">
        <field name="name">Pool Slots</field>
        <field name="res_model">fitzone.pool.slot</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_fitzone_pool_slot_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_fitzone_pool_slot_form')})
        ]" />
    </record>

    <!-- ==================== Pool Bookings ==================== -->

    <record id="view_fitzone_pool_booking_list" model="ir.ui.view">
        <field name="name">fitzone.pool.booking.list</field>
        <field name="model">fitzone.pool.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="member_id" />
                <field name="member_name" groups="fitzone.group_fitzone_trainer"/>
                <field name="membership_number" groups="fitzone.group_fitzone_trainer"/>
                <field name="membership_id" />
                <field name="pool_slot_id" />
                <field name="trainer_id"
                    column_invisible="context.get('hide_trainer_column', False)" />
                <field name="session_date" />
                <field name="booking_date" optional="hide" />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="view_fitzone_pool_booking_form" model="ir.ui.view">
        <field name="name">fitzone.pool.booking.form</field>
        <field name="model">fitzone.pool.booking</field>
        <field name="arch" type="xml">
            <form string="Pool Booking">
                <header>
                    <button name="action_cancel"
                        type="object"
                        string="Cancel Booking"
                        class="btn-secondary"
                        invisible="status != 'confirmed'" />
                </header>

                <sheet>
                    <group>
                        <field name="company_id" invisible="1" />
                        <field name="department_id" options="{'no_create': True}" invisible="1" />
                        <field name="member_id" />
                <field name="member_name" groups="fitzone.group_fitzone_trainer"/>
                <field name="membership_number" groups="fitzone.group_fitzone_trainer"/>
                        <field name="membership_id" />
                        <field name="pool_slot_id" />
                        <field name="session_date" />

                        <field name="is_free_swim" invisible="1" />

                        <field name="trainer_id"
                            invisible="is_free_swim"
                            required="not is_free_swim" />

                        <field name="booking_date" readonly="1" />
                        <field name="status" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_pool_booking" model="ir.actions.act_window">
        <field name="name">Pool Bookings</field>
        <field name="res_model">fitzone.pool.booking</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids"
            eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_fitzone_pool_booking_list')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_fitzone_pool_booking_form')})
        ]" />
    </record>

</odoo>