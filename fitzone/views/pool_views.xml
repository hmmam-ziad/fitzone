<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Pool Slots -->
    <record id="view_fitzone_pool_slot_list" model="ir.ui.view">
        <field name="name">fitzone.pool.slot.list</field>
        <field name="model">fitzone.pool.slot</field>
        <field name="arch" type="xml">
            <list>
                <field name="day_of_week"/>
                <field name="start_time" widget="float_time"/>
                <field name="end_time" widget="float_time"/>
                <field name="capacity"/>
                <field name="slot_type"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_pool_slot_form" model="ir.ui.view">
        <field name="name">fitzone.pool.slot.form</field>
        <field name="model">fitzone.pool.slot</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <group>
                    <field name="day_of_week"/>
                    <field name="start_time" widget="float_time"/>
                    <field name="end_time" widget="float_time"/>
                    <field name="capacity"/>
                    <field name="slot_type"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_pool_slot" model="ir.actions.act_window">
        <field name="name">Pool Slots</field>
        <field name="res_model">fitzone.pool.slot</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- Pool Bookings -->
    <record id="view_fitzone_pool_booking_list" model="ir.ui.view">
        <field name="name">fitzone.pool.booking.list</field>
        <field name="model">fitzone.pool.booking</field>
        <field name="arch" type="xml">
            <list>
                <field name="member_id"/>
                <field name="membership_id"/>
                <field name="pool_slot_id"/>
                <field name="trainer_id"/>
                <field name="booking_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="view_fitzone_pool_booking_form" model="ir.ui.view">
        <field name="name">fitzone.pool.booking.form</field>
        <field name="model">fitzone.pool.booking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                <group>
                    <field name="member_id"/>
                    <field name="membership_id"/>
                    <field name="pool_slot_id"/>
                    <field name="trainer_id"/>
                    <field name="booking_date"/>
                    <field name="status"/>
                </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_pool_booking" model="ir.actions.act_window">
        <field name="name">Pool Bookings</field>
        <field name="res_model">fitzone.pool.booking</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>