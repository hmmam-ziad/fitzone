<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_fitzone_members" model="ir.actions.act_window">
        <field name="name">Members</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_fitzone_member', '=', True)]</field>
    </record>

    <!-- Member fields on the contact form (res.partner) -->
    <record id="view_partner_form_fitzone" model="ir.ui.view">
        <field name="name">res.partner.form.fitzone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <!-- Salesperson defaults cannot refer to a server-restricted field. -->
            <xpath expr="//field[@name='parent_id']" position="attributes">
                <attribute name="context">{'default_is_company': True, 'show_address': False}</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']" position="attributes">
                <attribute name="context">{'default_parent_id': id, 'default_street': street, 'default_street2': street2, 'default_city': city, 'default_state_id': state_id, 'default_zip': zip, 'default_country_id': country_id, 'default_lang': lang, 'default_type': is_company and 'contact' or 'other'}</attribute>
            </xpath>
            <xpath expr="//chatter" position="attributes">
                <attribute name="groups">fitzone.group_fitzone_manager,fitzone.group_fitzone_reception</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="FitZone Member">

                    <button name="action_report_incident" type="object" string="Report incident" groups="fitzone.group_fitzone_trainer"/>
                    <group string="Basic Information">
                        <field name="is_fitzone_member" />
                        <field name="membership_no" readonly="1" />
                        <field name="birth_date" />
                    </group>

                    <separator string="Emergency Contacts" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception" />

                    <field name="emergency_contact_ids" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception">
                        <list editable="bottom">
                            <field name="name" />
                            <field name="phone" />
                            <field name="relationship" />
                        </list>
                    </field>

                    <separator string="Memberships" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception,fitzone.group_fitzone_trainer,fitzone.group_fitzone_physiotherapist,fitzone.group_fitzone_nutritionist" />

                    <field name="membership_ids" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception,fitzone.group_fitzone_trainer,fitzone.group_fitzone_physiotherapist,fitzone.group_fitzone_nutritionist">
                        <list>
                            <field name="package_id" />
                            <field name="barcode" />
                        </list>
                    </field>

                </page>
                <page name="fitzone_training_progress" string="Training plan / progress / sports notes" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_trainer">
                    <field name="progress_ids" context="{'default_member_id': id}"><list><field name="trainer_id"/><field name="record_date"/><field name="weight"/><field name="notes"/></list></field>
                </page>
                <page name="fitzone_visits" string="Visit history" groups="fitzone.group_fitzone_manager,fitzone.group_fitzone_reception,fitzone.group_fitzone_trainer">
                    <field name="visit_ids" readonly="1"><list create="0" edit="0" delete="0"><field name="visit_date"/><field name="status"/></list></field>
                </page>
                <page name="fitzone_restrictions" string="Injury restrictions &amp; forbidden movements" groups="fitzone.group_fitzone_physiotherapist,fitzone.group_fitzone_trainer,fitzone.group_fitzone_manager">
                    <field name="prohibited_exercises"/><field name="movement_restrictions"/>
                </page>
                <page name="fitzone_health_nutrition" string="Health &amp; Nutrition" groups="fitzone.group_fitzone_physiotherapist,fitzone.group_fitzone_nutritionist,fitzone.group_fitzone_manager">

                    <field name="health_profile_ids">
                        <list>
                            <field name="age" />
                            <field name="weight" />
                            <field name="height" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_partner_form_fitzone_movement_restrictions" model="ir.ui.view">
        <field name="name">res.partner.form.fitzone.movement.restrictions</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <div class="alert alert-warning" role="alert"
                    groups="fitzone.group_fitzone_physiotherapist,fitzone.group_fitzone_trainer,fitzone.group_fitzone_manager">
                    <group string="Trainer Movement Restrictions">
                        <field name="prohibited_exercises" readonly="1" />
                        <field name="movement_restrictions" readonly="1" />
                    </group>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Members filter on the Contacts search view -->
    <record id="view_res_partner_search_fitzone" model="ir.ui.view">
        <field name="name">res.partner.search.fitzone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter string="Members" name="fitzone_members"
                    domain="[('is_fitzone_member', '=', True)]" />
            </xpath>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- Emergency Contacts Views & Search -->
    <!-- ========================================== -->
    <record id="view_fitzone_emergency_contact_search" model="ir.ui.view">
        <field name="name">fitzone.emergency.contact.search</field>
        <field name="model">fitzone.emergency.contact</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Contact Name" />
                <field name="phone" />
                <field name="member_id" />
                <field name="relationship" />
                <separator />
                <filter string="Member" name="group_by_member"
                    context="{'group_by': 'member_id'}" />
                <filter string="Relationship" name="group_by_relationship"
                    context="{'group_by': 'relationship'}" />
            </search>
        </field>
    </record>

    <record id="view_fitzone_emergency_contact_list" model="ir.ui.view">
        <field name="name">fitzone.emergency.contact.list</field>
        <field name="model">fitzone.emergency.contact</field>
        <field name="arch" type="xml">
            <list>
                <field name="member_id" />
                <field name="name" />
                <field name="phone" />
                <field name="relationship" />
            </list>
        </field>
    </record>

    <record id="view_fitzone_emergency_contact_form" model="ir.ui.view">
        <field name="name">fitzone.emergency.contact.form</field>
        <field name="model">fitzone.emergency.contact</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="member_id" />
                        <field name="name" />
                        <field name="phone" />
                        <field name="relationship" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_emergency_contact" model="ir.actions.act_window">
        <field name="name">Emergency Contacts</field>
        <field name="res_model">fitzone.emergency.contact</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fitzone_emergency_contact_search" />
    </record>


    <!-- ========================================== -->
    <!-- Health Profiles Views & Search -->
    <!-- ========================================== -->
    <record id="view_fitzone_health_profile_search" model="ir.ui.view">
        <field name="name">fitzone.health.profile.search</field>
        <field name="model">fitzone.health.profile</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id" />
                <separator />
                <filter string="Member" name="group_by_member"
                    context="{'group_by': 'member_id'}" />
            </search>
        </field>
    </record>

    <record id="view_fitzone_health_profile_list" model="ir.ui.view">
        <field name="name">fitzone.health.profile.list</field>
        <field name="model">fitzone.health.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="member_id" />
                <field name="age" />
                <field name="weight" />
                <field name="height" />
            </list>
        </field>
    </record>

    <record id="view_fitzone_health_profile_form" model="ir.ui.view">
        <field name="name">fitzone.health.profile.form</field>
        <field name="model">fitzone.health.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="member_id" />
                        <field name="age" />
                        <field name="weight" />
                        <field name="height" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_health_profile" model="ir.actions.act_window">
        <field name="name">Health Profiles</field>
        <field name="res_model">fitzone.health.profile</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fitzone_health_profile_search" />
    </record>


    <!-- ========================================== -->
    <!-- Progress Tracking Views & Search -->
    <!-- ========================================== -->
    <record id="view_fitzone_progress_tracking_search" model="ir.ui.view">
        <field name="name">fitzone.progress.tracking.search</field>
        <field name="model">fitzone.progress.tracking</field>
        <field name="arch" type="xml">
            <search>
                <field name="member_id" />
                <field name="trainer_id" />
                <field name="record_date" />
                <separator />
                <filter string="Member" name="group_by_member"
                    context="{'group_by': 'member_id'}" />
                <filter string="Trainer" name="group_by_trainer"
                    context="{'group_by': 'trainer_id'}" />
                <filter string="Record Date" name="group_by_date"
                    context="{'group_by': 'record_date:month'}" />
            </search>
        </field>
    </record>

    <record id="view_fitzone_progress_tracking_list" model="ir.ui.view">
        <field name="name">fitzone.progress.tracking.list</field>
        <field name="model">fitzone.progress.tracking</field>
        <field name="arch" type="xml">
            <list>
                <field name="member_id" />
                <field name="trainer_id" />
                <field name="record_date" />
                <field name="weight" />
            </list>
        </field>
    </record>

    <record id="view_fitzone_progress_tracking_form" model="ir.ui.view">
        <field name="name">fitzone.progress.tracking.form</field>
        <field name="model">fitzone.progress.tracking</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="member_id" />
                        <field name="trainer_id" />
                        <field name="record_date" />
                        <field name="weight" />
                    </group>
                    <group>
                        <field name="notes" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fitzone_progress_tracking" model="ir.actions.act_window">
        <field name="name">Progress Tracking</field>
        <field name="res_model">fitzone.progress.tracking</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_fitzone_progress_tracking_search" />
    </record>

    <record id="view_partner_search_chatter_fitzone" model="ir.ui.view">
        <field name="name">res.partner.search.chatter.fitzone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="mail.res_partner_view_search_inherit_mail"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='filter_activities_my']" position="attributes">
                <attribute name="groups">fitzone.group_fitzone_manager,fitzone.group_fitzone_reception</attribute>
            </xpath>
            <xpath expr="//filter[@name='activities_overdue']" position="attributes">
                <attribute name="groups">fitzone.group_fitzone_manager,fitzone.group_fitzone_reception</attribute>
            </xpath>
            <xpath expr="//filter[@name='activities_today']" position="attributes">
                <attribute name="groups">fitzone.group_fitzone_manager,fitzone.group_fitzone_reception</attribute>
            </xpath>
            <xpath expr="//filter[@name='activities_upcoming_all']" position="attributes">
                <attribute name="groups">fitzone.group_fitzone_manager,fitzone.group_fitzone_reception</attribute>
            </xpath>
        </field>
    </record>

    <!-- Statistics invoke cross-addon computes, including calendar meeting_count.
         Keep them out of restricted clients before their field specs are built. -->
    <record id="view_partner_calendar_buttons_fitzone" model="ir.ui.view">
        <field name="name">res.partner.calendar.buttons.fitzone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="calendar.view_partners_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='schedule_meeting']" position="attributes">
                <attribute name="groups">fitzone.group_fitzone_manager,fitzone.group_fitzone_reception,fitzone.group_fitzone_sales,fitzone.group_fitzone_physiotherapist,fitzone.group_fitzone_nutritionist</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_partner_list_statistics_fitzone" model="ir.ui.view">
        <field name="name">res.partner.list.statistics.fitzone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='application_statistics']" position="attributes">
                <attribute name="groups">fitzone.group_fitzone_manager,fitzone.group_fitzone_reception</attribute>
            </xpath>
        </field>
    </record>
    <record id="view_partner_kanban_statistics_fitzone" model="ir.ui.view">
        <field name="name">res.partner.kanban.statistics.fitzone</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.res_partner_kanban_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='application_statistics']" position="attributes">
                <attribute name="groups">fitzone.group_fitzone_manager,fitzone.group_fitzone_reception</attribute>
            </xpath>
        </field>
    </record>
</odoo>