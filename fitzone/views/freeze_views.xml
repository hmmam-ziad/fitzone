<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========== Freeze Request Screen (Reception) ========== -->
    <record id="view_fitzone_freeze_request_wizard_form" model="ir.ui.view">
        <field name="name">fitzone.freeze.request.wizard.form</field>
        <field name="model">fitzone.freeze.request.wizard</field>
        <field name="arch" type="xml">
            <form string="Freeze Request">
                <group>
                    <group string="Request">
                        <field name="member_id"/>
                        <field name="membership_id"/>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>

                    <group string="Preview">
                        <field name="days"/>
                        <field name="allowed_days"/>
                        <field name="used_days"/>
                        <field name="remaining_days"/>
                        <field name="current_end_date"/>
                        <field name="new_end_date"/>
                    </group>
                </group>

                <footer>
                    <button name="action_request_freeze"
                            type="object"
                            string="Request Freeze"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fitzone_freeze_request_wizard"
            model="ir.actions.act_window">
        <field name="name">Freeze Request</field>
        <field name="res_model">fitzone.freeze.request.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <!-- ========== Freeze List: History Details ========== -->
    <record id="view_fitzone_freeze_list_log" model="ir.ui.view">
        <field name="name">fitzone.freeze.list.log</field>
        <field name="model">fitzone.freeze</field>
        <field name="inherit_id" ref="fitzone.view_fitzone_freeze_list"/>
        <field name="arch" type="xml">
            <field name="days" position="after">
                <field name="state"/>
                <field name="remaining_days"/>
                <field name="new_end_date"/>
                <field name="processed_by"/>
                <field name="cancelled_by"/>
                <field name="cancelled_at"/>
            </field>
        </field>
    </record>


    <!-- ========== Freeze Form: Header Button, Statusbar, and History ========== -->
    <record id="view_fitzone_freeze_form_log" model="ir.ui.view">
        <field name="name">fitzone.freeze.form.log</field>
        <field name="model">fitzone.freeze</field>
        <field name="inherit_id" ref="fitzone.view_fitzone_freeze_form"/>
        <field name="arch" type="xml">

            <!-- وضع الزر الأحمر وشريط المراحل في الأعلى قبل الـ sheet -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_cancel_freeze"
                            type="object"
                            string="Cancel Freeze"
                            class="btn-danger"
                            invisible="state != 'active'"
                            confirm="Are you sure you want to cancel this freeze?"/>
                    
                    <field name="state" widget="statusbar" statusbar_visible="active,cancelled"/>
                </header>
            </xpath>

            <!-- Make existing freeze data read-only after creation -->
            <field name="membership_id" position="attributes">
                <attribute name="readonly">id</attribute>
            </field>

            <field name="start_date" position="attributes">
                <attribute name="readonly">id</attribute>
            </field>

            <field name="end_date" position="attributes">
                <attribute name="readonly">id</attribute>
            </field>

            <!-- Freeze details and cancellation history -->
            <field name="days" position="after">
                <field name="allowed_days" readonly="1"/>
                <field name="remaining_days" readonly="1"/>
                <field name="previous_end_date" readonly="1"/>
                <field name="new_end_date" readonly="1"/>
                <field name="processed_by" readonly="1"/>
                <field name="cancelled_by" readonly="1"/>
                <field name="cancelled_at" readonly="1"/>
            </field>

        </field>
    </record>


    <!-- ========== Membership Form: Freeze Balance and History ========== -->
    <record id="view_fitzone_membership_form_freeze" model="ir.ui.view">
        <field name="name">fitzone.membership.form.freeze</field>
        <field name="model">fitzone.membership</field>
        <field name="inherit_id" ref="fitzone.view_fitzone_membership_form"/>
        <field name="arch" type="xml">

            <!-- Freeze balance -->
            <field name="date_end" position="after">
                <field name="freeze_allowed_days" readonly="1"/>
                <field name="freeze_used_days" readonly="1"/>
                <field name="freeze_remaining_days" readonly="1"/>
                <field name="freeze_grace_end" readonly="1"/>
            </field>

            <!-- Freeze history -->
            <xpath expr="//sheet" position="inside">
                <group string="Freeze History">
                    <field name="freeze_ids" nolabel="1" readonly="1">
                        <list>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days"/>
                            <field name="state"/>
                            <field name="remaining_days"/>
                            <field name="previous_end_date"/>
                            <field name="new_end_date"/>
                            <field name="processed_by"/>
                            <field name="cancelled_by"/>
                            <field name="cancelled_at"/>
                        </list>
                    </field>
                </group>
            </xpath>

        </field>
    </record>


    <!-- ========== Member Profile: Freeze History Tab ========== -->
    <record id="view_partner_form_freeze_history" model="ir.ui.view">
        <field name="name">res.partner.form.freeze.history</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Freeze History">
                    <field name="freeze_history_ids" readonly="1">
                        <list>
                            <field name="membership_id"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="days"/>
                            <field name="state"/>
                            <field name="remaining_days"/>
                            <field name="previous_end_date"/>
                            <field name="new_end_date"/>
                            <field name="processed_by"/>
                            <field name="cancelled_by"/>
                            <field name="cancelled_at"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>