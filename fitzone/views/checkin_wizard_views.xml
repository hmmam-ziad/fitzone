<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fitzone_checkin_wizard_form" model="ir.ui.view">
        <field name="name">fitzone.checkin.wizard.form</field>
        <field name="model">fitzone.checkin.wizard</field>
        <field name="arch" type="xml">
            <form string="Reception Check-in">
                <sheet>

                <group>
                    <field name="barcode" autofocus="1"/>
                    <field name="class_id" options="{'no_create': True}"/>
                </group>

                </sheet>
                <footer>
                    <button name="action_check_in"
                            string="Check In"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fitzone_checkin_wizard" model="ir.actions.act_window">
        <field name="name">Reception Check-in</field>
        <field name="res_model">fitzone.checkin.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_fitzone_checkin_wizard_form"/>
        <field name="target">new</field>
    </record>
</odoo>
