<odoo>
    <record id="invoice_line_reporting_department" model="ir.ui.view">
        <field name="name">account.move.line.reporting.department</field><field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml"><xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
            <field name="fitzone_department_id" domain="['|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]" optional="show" column_invisible="parent.move_type not in ('out_invoice','out_refund')" options="{'no_create': True}"/>
        </xpath></field>
    </record>
    <record id="pos_default_department_form" model="ir.ui.view">
        <field name="name">pos.config.default.department</field><field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml"><xpath expr="//div[@id='title']" position="after">
            <group><field name="fitzone_department_id" options="{'no_create': True}"/></group>
        </xpath></field>
    </record>
    <record id="pos_default_department_settings" model="ir.ui.view">
        <field name="name">pos.settings.default.department</field><field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml"><xpath expr="//block[@id='restaurant_section']" position="inside">
            <setting string="Default Department" help="Client-managed reporting fallback for products without a Reporting Department.">
                <field name="pos_fitzone_department_id" domain="['|', ('company_id', '=', False), ('company_id', '=', company_id)]" options="{'no_create': True}"/>
            </setting>
        </xpath></field>
    </record>
    <record id="collected_department_list" model="ir.ui.view">
        <field name="name">fitzone.collected.department.list</field><field name="model">fitzone.collected.department</field>
        <field name="arch" type="xml"><list create="0" edit="0" delete="0">
            <field name="date"/><field name="company_id" groups="base.group_multi_company"/>
            <field name="currency_id" column_invisible="1"/><field name="department_name"/>
            <field name="collected_cash" sum="Collected cash (Cash basis)"/>
        </list></field>
    </record>
    <record id="collected_department_pivot" model="ir.ui.view">
        <field name="name">fitzone.collected.department.pivot</field><field name="model">fitzone.collected.department</field>
        <field name="arch" type="xml"><pivot string="Collected by Department (Cash basis)" disable_linking="1">
            <field name="department_id" type="row"/><field name="date" type="col" interval="month"/>
            <field name="collected_cash" type="measure"/>
        </pivot></field>
    </record>
    <record id="collected_department_graph" model="ir.ui.view">
        <field name="name">fitzone.collected.department.graph</field><field name="model">fitzone.collected.department</field>
        <field name="arch" type="xml"><graph string="Collected by Department (Cash basis)" type="bar">
            <field name="department_id"/><field name="collected_cash" type="measure"/>
        </graph></field>
    </record>
    <record id="collected_department_search" model="ir.ui.view">
        <field name="name">fitzone.collected.department.search</field><field name="model">fitzone.collected.department</field>
        <field name="arch" type="xml"><search><field name="department_id"/><field name="date"/>
            <filter name="unassigned" string="Unassigned" domain="[('department_id','=',False)]"/>
            <filter name="department" string="Department" context="{'group_by':'department_id'}"/>
            <filter name="period" string="Collection date" date="date"/>
        </search></field>
    </record>
    <record id="action_collected_department" model="ir.actions.act_window">
        <field name="name">Collected by Department (Cash basis)</field><field name="res_model">fitzone.collected.department</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="group_ids" eval="[(6,0,[ref('group_fitzone_manager')])]"/>
    </record>
    <record id="collected_department_company_rule" model="ir.rule">
        <field name="name">Collected cash: allowed companies</field><field name="model_id" ref="model_fitzone_collected_department"/>
        <field name="domain_force">[('company_id','in',company_ids)]</field>
    </record>
</odoo>
