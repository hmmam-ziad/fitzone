<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_fitzone" model="ir.ui.view">
        <field name="name">hr.employee.form.fitzone</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="before">
                <field name="fitzone_employee_no"
                       string="Employee ID"
                       readonly="1"/>
            </xpath>

        </field>
    </record>
</odoo>